# Storix keeps Unix line endings everywhere. A shell script or a systemd unit
# with CRLF endings simply does not run on the servers this product targets.
# Developed by X Project.

* text=auto eol=lf

*.sh      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.go      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.sql     text eol=lf
*.service text eol=lf
Makefile  text eol=lf
LICENSE   text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.tar.gz binary
